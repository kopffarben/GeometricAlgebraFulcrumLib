using System;
using System.Linq;
using GeometricAlgebraFulcrumLib.Algebra.LinearAlgebra.Float64.Vectors.Space2D;
using GeometricAlgebraFulcrumLib.Algebra.LinearAlgebra.Float64.Vectors.Space3D;
using GeometricAlgebraFulcrumLib.Algebra.LinearAlgebra.Float64.Vectors.SpaceND;
using NUnit.Framework;

namespace GeometricAlgebraFulcrumLib.UnitTests.LinearAlgebra;

/// <summary>
/// Comprehensive tests for Float64 vector operations
/// </summary>
[TestFixture]
public class Float64VectorTests
{
    private const double Tolerance = 1e-12;

    [TestFixture]
    public class Float64Vector2DTests
    {
        [Test]
        public void Float64Vector2D_Creation_ShouldHandleVariousInputs()
        {
            // Test basic creation
            var v1 = Float64Vector2D.Create(3.0, 4.0);
            Assert.That(v1.X, Is.EqualTo(3.0).Within(Tolerance));
            Assert.That(v1.Y, Is.EqualTo(4.0).Within(Tolerance));

            // Test zero vector
            var zero = Float64Vector2D.Zero;
            Assert.That(zero.X, Is.EqualTo(0.0).Within(Tolerance));
            Assert.That(zero.Y, Is.EqualTo(0.0).Within(Tolerance));
            Assert.That(zero.IsZero(), Is.True);

            // Test unit vectors
            var unitX = Float64Vector2D.UnitX;
            var unitY = Float64Vector2D.UnitY;
            Assert.That(unitX.X, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(unitX.Y, Is.EqualTo(0.0).Within(Tolerance));
            Assert.That(unitY.X, Is.EqualTo(0.0).Within(Tolerance));
            Assert.That(unitY.Y, Is.EqualTo(1.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector2D_Magnitude_ShouldBeCorrect()
        {
            var v = Float64Vector2D.Create(3.0, 4.0);
            
            // Test magnitude
            Assert.That(v.ENorm(), Is.EqualTo(5.0).Within(Tolerance));
            Assert.That(v.ENormSquared(), Is.EqualTo(25.0).Within(Tolerance));

            // Test unit vector
            var unit = v.ToUnitVector();
            Assert.That(unit.ENorm(), Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(unit.X, Is.EqualTo(0.6).Within(Tolerance));
            Assert.That(unit.Y, Is.EqualTo(0.8).Within(Tolerance));
        }

        [Test]
        public void Float64Vector2D_ArithmeticOperations_ShouldBeCorrect()
        {
            var v1 = Float64Vector2D.Create(2.0, 3.0);
            var v2 = Float64Vector2D.Create(1.0, -1.0);

            // Addition
            var sum = v1 + v2;
            Assert.That(sum.X, Is.EqualTo(3.0).Within(Tolerance));
            Assert.That(sum.Y, Is.EqualTo(2.0).Within(Tolerance));

            // Subtraction
            var diff = v1 - v2;
            Assert.That(diff.X, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(diff.Y, Is.EqualTo(4.0).Within(Tolerance));

            // Scalar multiplication
            var scaled = v1 * 2.0;
            Assert.That(scaled.X, Is.EqualTo(4.0).Within(Tolerance));
            Assert.That(scaled.Y, Is.EqualTo(6.0).Within(Tolerance));

            // Negation
            var negated = -v1;
            Assert.That(negated.X, Is.EqualTo(-2.0).Within(Tolerance));
            Assert.That(negated.Y, Is.EqualTo(-3.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector2D_DotProduct_ShouldBeCorrect()
        {
            var v1 = Float64Vector2D.Create(2.0, 3.0);
            var v2 = Float64Vector2D.Create(1.0, -1.0);

            var dotProduct = v1.ESp(v2);
            Assert.That(dotProduct, Is.EqualTo(-1.0).Within(Tolerance));

            // Test orthogonal vectors
            var v3 = Float64Vector2D.Create(1.0, 0.0);
            var v4 = Float64Vector2D.Create(0.0, 1.0);
            Assert.That(v3.ESp(v4), Is.EqualTo(0.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector2D_Angle_ShouldBeCorrect()
        {
            var v1 = Float64Vector2D.Create(1.0, 0.0);
            var v2 = Float64Vector2D.Create(0.0, 1.0);

            var angle = v1.GetAngle(v2);
            Assert.That(angle.Radians, Is.EqualTo(Math.PI / 2).Within(Tolerance));

            // Test angle with itself (should be 0)
            var selfAngle = v1.GetAngle(v1);
            Assert.That(selfAngle.Radians, Is.EqualTo(0.0).Within(Tolerance));
        }
    }

    [TestFixture]
    public class Float64Vector3DTests
    {
        [Test]
        public void Float64Vector3D_Creation_ShouldHandleVariousInputs()
        {
            // Test basic creation
            var v1 = Float64Vector3D.Create(1.0, 2.0, 3.0);
            Assert.That(v1.X, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(v1.Y, Is.EqualTo(2.0).Within(Tolerance));
            Assert.That(v1.Z, Is.EqualTo(3.0).Within(Tolerance));

            // Test zero vector
            var zero = Float64Vector3D.Zero;
            Assert.That(zero.IsZero(), Is.True);

            // Test unit vectors
            var unitX = Float64Vector3D.UnitX;
            var unitY = Float64Vector3D.UnitY;
            var unitZ = Float64Vector3D.UnitZ;
            
            Assert.That(unitX.X, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(unitY.Y, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(unitZ.Z, Is.EqualTo(1.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector3D_CrossProduct_ShouldBeCorrect()
        {
            var v1 = Float64Vector3D.Create(1.0, 0.0, 0.0);
            var v2 = Float64Vector3D.Create(0.0, 1.0, 0.0);

            var cross = v1.VectorCross(v2);
            Assert.That(cross.X, Is.EqualTo(0.0).Within(Tolerance));
            Assert.That(cross.Y, Is.EqualTo(0.0).Within(Tolerance));
            Assert.That(cross.Z, Is.EqualTo(1.0).Within(Tolerance));

            // Test anti-commutativity: a × b = -(b × a)
            var cross2 = v2.VectorCross(v1);
            Assert.That(cross2.Z, Is.EqualTo(-1.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector3D_Magnitude_ShouldBeCorrect()
        {
            var v = Float64Vector3D.Create(2.0, 3.0, 6.0);
            
            // Test magnitude (2² + 3² + 6² = 4 + 9 + 36 = 49, sqrt(49) = 7)
            Assert.That(v.ENorm(), Is.EqualTo(7.0).Within(Tolerance));
            Assert.That(v.ENormSquared(), Is.EqualTo(49.0).Within(Tolerance));

            // Test unit vector
            var unit = v.ToUnitVector();
            Assert.That(unit.ENorm(), Is.EqualTo(1.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector3D_TripleProduct_ShouldBeCorrect()
        {
            var v1 = Float64Vector3D.Create(1.0, 0.0, 0.0);
            var v2 = Float64Vector3D.Create(0.0, 1.0, 0.0);
            var v3 = Float64Vector3D.Create(0.0, 0.0, 1.0);

            // Scalar triple product a · (b × c) should equal volume of parallelepiped
            var cross = v2.VectorCross(v3);
            var tripleProduct = v1.ESp(cross);
            Assert.That(tripleProduct, Is.EqualTo(1.0).Within(Tolerance));
        }

        [Test]
        public void Float64Vector3D_Reflection_ShouldBeCorrect()
        {
            var incident = Float64Vector3D.Create(1.0, -1.0, 0.0);
            var normal = Float64Vector3D.Create(0.0, 1.0, 0.0);

            var reflected = incident.ReflectOn(normal);
            
            // Expected reflection: (1, 1, 0)
            Assert.That(reflected.X, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(reflected.Y, Is.EqualTo(1.0).Within(Tolerance));
            Assert.That(reflected.Z, Is.EqualTo(0.0).Within(Tolerance));
        }
    }

    [TestFixture]
    public class Float64VectorNDTests
    {
        [Test]
        public void Float64VectorND_Creation_ShouldHandleVariousInputs()
        {
            // Test creation from array
            var values = new double[] { 1.0, 2.0, 3.0, 4.0 };
            var vector = Float64VectorND.Create(values);
            
            Assert.That(vector.VSpaceDimensions, Is.EqualTo(4));
            for (int i = 0; i < values.Length; i++)
            {
                Assert.That(vector[i], Is.EqualTo(values[i]).Within(Tolerance));
            }

            // Test zero vector
            var zero = Float64VectorND.CreateZero(5);
            Assert.That(zero.VSpaceDimensions, Is.EqualTo(5));
            Assert.That(zero.IsZero(), Is.True);
        }

        [Test]
        public void Float64VectorND_ArithmeticOperations_ShouldBeCorrect()
        {
            var v1 = Float64VectorND.Create(1.0, 2.0, 3.0);
            var v2 = Float64VectorND.Create(4.0, 5.0, 6.0);

            // Addition
            var sum = v1 + v2;
            Assert.That(sum[0], Is.EqualTo(5.0).Within(Tolerance));
            Assert.That(sum[1], Is.EqualTo(7.0).Within(Tolerance));
            Assert.That(sum[2], Is.EqualTo(9.0).Within(Tolerance));

            // Subtraction
            var diff = v2 - v1;
            Assert.That(diff[0], Is.EqualTo(3.0).Within(Tolerance));
            Assert.That(diff[1], Is.EqualTo(3.0).Within(Tolerance));
            Assert.That(diff[2], Is.EqualTo(3.0).Within(Tolerance));

            // Scalar multiplication
            var scaled = v1 * 2.0;
            Assert.That(scaled[0], Is.EqualTo(2.0).Within(Tolerance));
            Assert.That(scaled[1], Is.EqualTo(4.0).Within(Tolerance));
            Assert.That(scaled[2], Is.EqualTo(6.0).Within(Tolerance));
        }

        [Test]
        public void Float64VectorND_DotProduct_ShouldBeCorrect()
        {
            var v1 = Float64VectorND.Create(1.0, 2.0, 3.0);
            var v2 = Float64VectorND.Create(4.0, 5.0, 6.0);

            var dotProduct = v1.ESp(v2);
            // 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32
            Assert.That(dotProduct, Is.EqualTo(32.0).Within(Tolerance));
        }

        [Test]
        public void Float64VectorND_Magnitude_ShouldBeCorrect()
        {
            var v = Float64VectorND.Create(3.0, 4.0, 0.0, 0.0);
            
            // Should be 5.0 (3-4-5 triangle)
            Assert.That(v.ENorm(), Is.EqualTo(5.0).Within(Tolerance));
            Assert.That(v.ENormSquared(), Is.EqualTo(25.0).Within(Tolerance));

            // Test unit vector
            var unit = v.ToUnitVector();
            Assert.That(unit.ENorm(), Is.EqualTo(1.0).Within(Tolerance));
        }

        [Test]
        public void Float64VectorND_Projection_ShouldBeCorrect()
        {
            var v = Float64VectorND.Create(3.0, 4.0);
            var axis = Float64VectorND.Create(1.0, 0.0);

            var projection = v.ProjectOn(axis);
            
            // Projection should be (3, 0)
            Assert.That(projection[0], Is.EqualTo(3.0).Within(Tolerance));
            Assert.That(projection[1], Is.EqualTo(0.0).Within(Tolerance));
        }

        [Test]
        public void Float64VectorND_OrthogonalityTest_ShouldWork()
        {
            var v1 = Float64VectorND.Create(1.0, 0.0, 0.0);
            var v2 = Float64VectorND.Create(0.0, 1.0, 0.0);
            var v3 = Float64VectorND.Create(1.0, 1.0, 0.0);

            // v1 and v2 should be orthogonal
            Assert.That(v1.IsOrthogonalTo(v2), Is.True);
            
            // v1 and v3 should not be orthogonal
            Assert.That(v1.IsOrthogonalTo(v3), Is.False);
        }
    }
}