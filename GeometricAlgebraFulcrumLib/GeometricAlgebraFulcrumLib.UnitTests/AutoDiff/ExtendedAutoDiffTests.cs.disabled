using System;
using System.Linq;
using GeometricAlgebraFulcrumLib.Modeling.Calculus.AutoDiff;
using NUnit.Framework;

namespace GeometricAlgebraFulcrumLib.UnitTests.AutoDiff;

/// <summary>
/// Extended comprehensive tests for automatic differentiation functionality using the correct API
/// </summary>
[TestFixture]
public class ExtendedAutoDiffTests
{
    private const double Tolerance = 1e-12;

    [Test]
    public void AutoDiff_BasicOperations_ShouldComputeCorrectDerivatives()
    {
        // Test f(x) = x^2, f'(x) = 2x
        var x = new Variable();
        var f = x * x;
        
        // Create compiler and differentiate
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 3: f(3) = 9, f'(3) = 6
        var vars = new[] { 3.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(9.0).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(6.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_ConstantTerm_ShouldHaveZeroDerivative()
    {
        var constant = TermBuilder.Constant(42.0);
        var x = new Variable();
        
        var compiler = new CompiledDifferentiator(constant, x);
        var compiled = compiler.Compile();
        
        var vars = new[] { 1.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(42.0).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(0.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_LinearFunction_ShouldHaveConstantDerivative()
    {
        // Test f(x) = 3x + 5, f'(x) = 3
        var x = new Variable();
        var three = TermBuilder.Constant(3.0);
        var five = TermBuilder.Constant(5.0);
        var f = three * x + five;
        
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 2: f(2) = 11, f'(2) = 3
        var vars = new[] { 2.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(11.0).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(3.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_ProductRule_ShouldWorkCorrectly()
    {
        // Test f(x) = x * x^2 = x^3, f'(x) = 3x^2
        var x = new Variable();
        var x2 = x * x;
        var f = x * x2;
        
        var compiler = new CompiledDifferentiator(f, x);  
        var compiled = compiler.Compile();
        
        // Test at x = 2: f(2) = 8, f'(2) = 12
        var vars = new[] { 2.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(8.0).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(12.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_SumRule_ShouldWorkCorrectly()
    {
        // Test f(x) = x^2 + x^3, f'(x) = 2x + 3x^2
        var x = new Variable();
        var x2 = x * x;
        var x3 = x2 * x;
        var f = x2 + x3;
        
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 2: f(2) = 4 + 8 = 12, f'(2) = 4 + 12 = 16
        var vars = new[] { 2.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(12.0).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(16.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_ExponentialFunction_ShouldWorkCorrectly()
    {
        // Test f(x) = exp(x), f'(x) = exp(x)
        var x = new Variable();
        var f = TermBuilder.Exp(x);
        
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 1: f(1) = e, f'(1) = e
        var vars = new[] { 1.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(Math.E).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(Math.E).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_LogarithmFunction_ShouldWorkCorrectly()
    {
        // Test f(x) = log(x), f'(x) = 1/x
        var x = new Variable();
        var f = TermBuilder.Log(x);
        
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 2: f(2) = log(2), f'(2) = 1/2 = 0.5
        var vars = new[] { 2.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(Math.Log(2.0)).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(0.5).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_PowerFunction_ShouldWorkCorrectly()
    {
        // Test f(x) = x^3, f'(x) = 3x^2
        var x = new Variable();
        var three = TermBuilder.Constant(3.0);
        var f = TermBuilder.Power(x, three);
        
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 2: f(2) = 8, f'(2) = 12
        var vars = new[] { 2.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(8.0).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(12.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_MultipleVariables_ShouldComputePartialDerivatives()
    {
        // Test f(x,y) = x^2 + y^2, ∂f/∂x = 2x, ∂f/∂y = 2y
        var x = new Variable();
        var y = new Variable();
        var f = x * x + y * y;
        
        var compilerX = new CompiledDifferentiator(f, x, y);
        var compiledX = compilerX.Compile();
        
        var compilerY = new CompiledDifferentiator(f, y, x);
        var compiledY = compilerY.Compile();
        
        // Test at (x,y) = (3,4): f(3,4) = 25, ∂f/∂x = 6, ∂f/∂y = 8
        var vars = new[] { 3.0, 4.0 };
        var result = compiledX.Evaluate(vars);
        var derivativeX = compiledX.Differentiate(vars);
        var derivativeY = compiledY.Differentiate(new[] { 4.0, 3.0 });
        
        Assert.That(result, Is.EqualTo(25.0).Within(Tolerance));
        Assert.That(derivativeX[0], Is.EqualTo(6.0).Within(Tolerance));
        Assert.That(derivativeY[0], Is.EqualTo(8.0).Within(Tolerance));
    }

    [Test]
    public void AutoDiff_ChainRule_ShouldWorkCorrectly()
    {
        // Test f(x) = exp(x^2), f'(x) = exp(x^2) * 2x
        var x = new Variable(); 
        var x2 = x * x;
        var f = TermBuilder.Exp(x2);
        
        var compiler = new CompiledDifferentiator(f, x);
        var compiled = compiler.Compile();
        
        // Test at x = 1: f(1) = exp(1) = e, f'(1) = e * 2 = 2e
        var vars = new[] { 1.0 };
        var result = compiled.Evaluate(vars);
        var derivative = compiled.Differentiate(vars);
        
        Assert.That(result, Is.EqualTo(Math.E).Within(Tolerance));
        Assert.That(derivative[0], Is.EqualTo(2.0 * Math.E).Within(Tolerance));
    }
}