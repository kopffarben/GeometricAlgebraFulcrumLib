<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>

    <!-- Float32 Source Generator Configuration -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngouriMath" Version="1.3.0" />
    <PackageReference Include="Dew.Lab.Studio" Version="6.2.3" />
    <PackageReference Include="Dew.Lab.Studio.Core" Version="6.2.3" />
    <PackageReference Include="Dew.Math" Version="6.2.3" />
    <PackageReference Include="Dew.Math.Core" Version="6.2.3" />
    <PackageReference Include="Dew.Signal" Version="6.2.3" />
    <PackageReference Include="Dew.Signal.Core" Version="6.2.3" />
    <PackageReference Include="Dew.Stats" Version="6.2.3" />
    <PackageReference Include="Dew.Stats.Core" Version="6.2.3" />
    <PackageReference Include="EPPlus" Version="8.0.7" />
    <PackageReference Include="HonkPerf.NET.Core" Version="1.0.2" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NumpyDotNet" Version="0.9.87.2" />
    <PackageReference Include="OxyPlot.Core" Version="2.2.0" />
    <PackageReference Include="OxyPlot.Core.Drawing" Version="2.1.0" />
    <PackageReference Include="OxyPlot.SkiaSharp" Version="2.2.0" />
    <PackageReference Include="PeterO.Numbers" Version="1.8.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeometricAlgebraFulcrumLib.Utilities.Structures\GeometricAlgebraFulcrumLib.Utilities.Structures.csproj" />
    <ProjectReference Include="..\GeometricAlgebraFulcrumLib.Utilities.Text\GeometricAlgebraFulcrumLib.Utilities.Text.csproj" />
  </ItemGroup>

  <!-- Float32 Source Generator Reference -->
  <ItemGroup>
    <ProjectReference Include="..\GeometricAlgebraFulcrumLib.CodeGeneration\GeometricAlgebraFulcrumLib.CodeGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Float64 Files as AdditionalFiles for Generator -->
  <!-- Excluding ONLY problematic files: -->
  <!-- - Float64Utils.cs: manual Float32Utils.cs exists in Scalars/Float32/ -->
  <!-- PHASE 1 COMPLETE: UnaryBinaryOps.cs NOW INCLUDED - Rewriter handles float/double duplicates -->
  <!-- PHASE 2 COMPLETE: Utils.cs NOW INCLUDED - Rewriter skips extension methods with 'this float' parameter -->
  <!-- NOTE: Rewriter filters out duplicates by skipping operators/methods with float parameters -->
  <ItemGroup>
    <AdditionalFiles Include="Scalars\Float64\**\*.cs" Exclude="Scalars\Float64\Float64Utils.cs" />
    <AdditionalFiles Include="LinearAlgebra\Float64\**\*.cs"
                     Exclude="LinearAlgebra\Float64\Vectors\Space3D\ILinFloat64Vector3D.cs;LinearAlgebra\Float64\Vectors\Space2D\ILinFloat64Vector2D.cs" />
    <AdditionalFiles Include="GeometricAlgebra\Float64\**\*.cs" />
    <AdditionalFiles Include="Polynomials\Float64\**\*.cs" />
  </ItemGroup>

  <!-- Clean Generated Files Before Build -->
  <!-- This ensures stale generated files don't cause build errors -->
  <Target Name="CleanGeneratedFiles" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedPath>$(BaseIntermediateOutputPath)Generated</GeneratedPath>
    </PropertyGroup>
    <RemoveDir Directories="$(GeneratedPath)" Condition="Exists('$(GeneratedPath)')" />
    <Message Text="Float32 Generator: Cleaned generated files at $(GeneratedPath)" Importance="high" Condition="Exists('$(GeneratedPath)')" />
  </Target>

</Project>
