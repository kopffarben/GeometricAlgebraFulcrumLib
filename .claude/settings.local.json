{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(while read expected)",
      "Bash(do actual=\"obj/Generated/GAF.Gen/GAF.Gen.F32Gen/$expected\" if [ ! -f \"$actual\" ])",
      "Bash(powershell.exe:*)",
      "Bash(if [ -d \"GeometricAlgebraFulcrumLib/GeometricAlgebraFulcrumLib.Modeling/obj/Generated\" ])",
      "Bash(then rm -rf \"GeometricAlgebraFulcrumLib/GeometricAlgebraFulcrumLib.Modeling/obj/Generated\")",
      "Bash(Select-String -Pattern \"(error|warning|Build)\")",
      "Bash(Select-Object -First 50)",
      "Bash(if [ -d \"GeometricAlgebraFulcrumLib/GeometricAlgebraFulcrumLib.Algebra/obj/Generated\" ])",
      "Bash(then rm -rf \"GeometricAlgebraFulcrumLib/GeometricAlgebraFulcrumLib.Algebra/obj/Generated\")",
      "Bash(else echo \"No Algebra cache\")",
      "Bash(xargs -r kill)",
      "Bash(else echo \"No generated cache\")"
    ],
    "deny": [],
    "ask": []
  }
}
